# Normalise line endings so a checkout is byte-identical on every platform.
#
# Without this, core.autocrlf=true on Windows rewrites every text file to CRLF on
# checkout. Installers copy skill files verbatim, so the installed skills would
# differ by platform, and anything reading a SKILL.md with an LF-only parser
# rejects a file that is perfectly valid.
* text=auto eol=lf

# Binary: never touch these.
*.png binary
*.jpg binary
*.gif binary
*.pdf binary
*.ico binary
*.woff binary
*.woff2 binary
